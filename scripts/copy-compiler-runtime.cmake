cmake_minimum_required(VERSION 3.20)
if(NOT EXISTS "${MANIFEST}" OR NOT IS_DIRECTORY "${OUTPUT}")
    message(FATAL_ERROR "Compiler runtime manifest or output directory is missing")
endif()
file(STRINGS "${MANIFEST}" runtime_files ENCODING UTF-8)
if(WIN32 AND NOT runtime_files)
    message(FATAL_ERROR "MSVC redistributables were not detected; reconfigure with Visual Studio installed")
endif()
foreach(runtime IN LISTS runtime_files)
    if(NOT EXISTS "${runtime}")
        message(FATAL_ERROR "Compiler redistributable is missing: ${runtime}")
    endif()
    file(COPY "${runtime}" DESTINATION "${OUTPUT}")
endforeach()
list(LENGTH runtime_files runtime_count)
message(STATUS "Copied ${runtime_count} compiler runtime libraries")
